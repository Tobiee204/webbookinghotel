<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelManagement.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Header Navigation Colors */
        :root {
            --light-beige: #F5F1ED;
            --gold-accent: #C6A96D;
     --gold-dark: #A68B5B;
     --dark-text: #333;
    }

        .navbar-custom {
 background-color: var(--light-beige) !important;
      box-shadow: 0 2px 8px rgba(198, 169, 109, 0.15);
       border-bottom: 3px solid var(--gold-accent);
  }

      .navbar-custom .navbar-brand {
            color: var(--gold-accent) !important;
  font-weight: 700;
            font-size: 1.5rem;
   letter-spacing: 0.5px;
  }

        .navbar-custom .navbar-brand:hover {
            color: var(--gold-dark) !important;
      }

        .navbar-custom .nav-link {
            color: var(--dark-text) !important;
            font-weight: 500;
         transition: all 0.3s ease;
         margin: 0 8px;
}

  .navbar-custom .nav-link:hover {
  color: var(--gold-accent) !important;
        }

        .navbar-custom .navbar-toggler {
    border-color: var(--gold-accent);
        }

        .navbar-custom .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23C6A96D' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .btn-booking {
        background-color: var(--gold-accent) !important;
         color: white !important;
  border-color: var(--gold-accent) !important;
 font-weight: 600;
            transition: all 0.3s ease;
 }

        .btn-booking:hover {
   background-color: var(--gold-dark) !important;
    border-color: var(--gold-dark) !important;
transform: translateY(-2px);
 box-shadow: 0 4px 12px rgba(198, 169, 109, 0.3);
        }

        .btn-login {
       color: var(--dark-text) !important;
 font-weight: 500;
            transition: all 0.3s ease;
        }

   .btn-login:hover {
     color: var(--gold-accent) !important;
        }


    </style>

        <style >
        .zalo-wrapper {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
        }

        /* ICON */
        .zalo-chat {
            display: block;
            width: 65px;
            height: 65px;
            border-radius: 50%;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            animation: shake 2s infinite;
            transition: 0.3s;
        }

            .zalo-chat img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /* HOVER */
            .zalo-chat:hover {
                transform: scale(1.15);
            }

        /* TOOLTIP */
        .zalo-tooltip {
            position: absolute;
            right: 75px;
            bottom: 18px;
            background: #333;
            color: white;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 13px;
            opacity: 0;
            transform: translateX(10px);
            transition: 0.3s;
            white-space: nowrap;
        }

        /* SHOW TOOLTIP */
        .zalo-wrapper:hover .zalo-tooltip {
            opacity: 1;
            transform: translateX(0);
        }

        /* RUNG NHẸ */
        @@keyframes shake {
            0%

        {
            transform: rotate(0deg);
        }

        2% {
            transform: rotate(-5deg);
        }

        4% {
            transform: rotate(5deg);
        }

        6% {
            transform: rotate(-5deg);
        }

        8% {
            transform: rotate(5deg);
        }

        10% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(0deg);
        }

        }

	</style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
<div class="container">

         <a class="navbar-brand" asp-page="/Index">Angel Hotel</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
    </button>

        <div class="collapse navbar-collapse" id="navbarNav">

         <ul class="navbar-nav me-auto">

          <li class="nav-item">
    <a class="nav-link" asp-page="/Index">Home</a>
    </li>

    <li class="nav-item">
         <a class="nav-link" asp-page="/Hotels">Rooms</a>
                 </li>

      <li class="nav-item">
             <a class="nav-link" asp-page="/SpecialOffer">Special Offers</a>
       </li>

      <li class="nav-item">
             <a class="nav-link" asp-page="/Service">Services</a>
      </li>

          <li class="nav-item">
    <a class="nav-link" href="#reviews">Reviews</a>
     </li>

     <li class="nav-item">
                <a class="nav-link" href="#contact">Contact</a>
      </li>

       </ul>

                    @{
                        var userName = Context.Session.GetString("UserName");
                    }

                    <ul class="navbar-nav ms-auto">

                        @if (userName != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">

                                    @{
                                        var avatar = Context.Session.GetString("Avatar");
                                    }

                                    <img src="@(string.IsNullOrEmpty(avatar)
                                                     ? "/images/default-avatar.png"
                                                     : avatar)"
                                     style="width:35px; height:35px; border-radius:50%; margin-right:8px;" />

                                    @userName
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Profile">Profile</a></li>
                                    <li><a class="dropdown-item text-danger" asp-page="/Logout">Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-login" asp-page="/Login">Login</a>
                            </li>
                        }

                    </ul>

      </div>
</div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
    @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white py-4">

        <div class="container text-center">

    <p>© Angel Hotel</p>

    <p>507, Nguyen Thi Thap</p>

    <p>Contact: 0359548474. Facebook: Le Viet Loi</p>

            <p>
         About | Contact | Privacy Policy
            </p>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ZALO CHAT FLOAT BUTTON -->
    <div class="zalo-wrapper">
        <span class="zalo-tooltip">Chat with us</span>

        <a href="https://zalo.me/0359548474" target="_blank" class="zalo-chat">
            <img src="/images/zalo-icon.png" alt="Zalo Chat" />
        </a>
    </div>
</body>
</html>