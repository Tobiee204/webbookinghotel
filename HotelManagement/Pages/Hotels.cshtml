@page
@model HotelManagement.Pages.HotelsModel

<section class="container py-5">

    <h2 class="text-center mb-5">Rooms</h2>

    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group shadow-sm">

            <a href="?status=all"
               class="btn btn-outline-dark @(Request.Query["status"] == "all" || string.IsNullOrEmpty(Request.Query["status"]) ? "active" : "")">
                All
            </a>

            <a href="?status=Available"
               class="btn btn-outline-success @(Request.Query["status"] == "Available" ? "active" : "")">
                Available
            </a>

            <a href="?status=pending"
               class="btn btn-outline-warning @(Request.Query["status"] == "Pending" ? "active" : "")">
                Pending
            </a>

            <a href="?status=booked"
               class="btn btn-outline-danger @(Request.Query["status"] == "Booked" ? "active" : "")">
                Booked
            </a>

        </div>
    </div>

    <div class="row g-4">

        @foreach (var r in Model.Rooms)
        {
            <div class="col-md-4">
                <div class="card room-card shadow">

                    <img src="@(string.IsNullOrEmpty(r.image) ? "/images/default.jpg" : r.image)"
                         class="card-img-top">

                    <div class="card-body text-center">

                        <h5>@r.title</h5>
                        <p class="text-muted">@r.room_type</p>

                        <p class="text-primary fw-bold">
                            @r.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ
                        </p>

                        <p>
                            Status:
                            @if (r.status == "Available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (r.status == "pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@r.status</span>
                            }
                        </p>

                        <p>
                            👤 @r.guests guests | 🛏 @r.bed_type
                        </p>

                        <a asp-page="/HotelDetails" asp-route-id="@r.room_id" class="btn btn-outline-primary">
                            View Details
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>

</section>


<style>

    .room-card {
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .room-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    .card-img-top {
        height: 220px;
        object-fit: cover;
    }

</style>