@page
@model HotelManagement.Pages.HotelsModel

<style>

    .room-card {
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .room-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    .card-img-top {
        height: 220px;
        object-fit: cover;
    }

    .text-warning span {
        font-size: 20px;
    }

</style>

<section class="container py-5">

    <h2 class="text-center mb-5">Rooms</h2>

    @if (TempData["NotFound"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["NotFound"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group shadow-sm">

            <a href="?status=all"
               class="btn btn-outline-dark @(Request.Query["status"] == "all" || string.IsNullOrEmpty(Request.Query["status"]) ? "active" : "")">
                All
            </a>

            <a href="?status=Available"
               class="btn btn-outline-success @(Request.Query["status"] == "Available" ? "active" : "")">
                Available
            </a>

            <a href="?status=pending"
               class="btn btn-outline-warning @(Request.Query["status"] == "Pending" ? "active" : "")">
                Pending
            </a>

            <a href="?status=booked"
               class="btn btn-outline-danger @(Request.Query["status"] == "Booked" ? "active" : "")">
                Booked
            </a>

        </div>

    </div>

    <div class="d-flex justify-content-center mb-4">
    <!-- CATEGORY FILTER -->
    <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">
            Category
        </button>

        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item"
                   href="?category=all">
                    All
                </a>
            </li>
            <li>
                <a class="dropdown-item"
                   href="?category=VIP">
                    VIP
                </a>
            </li>
            <li>
                <a class="dropdown-item"
                   href="?category=Normal">
                    Normal
                </a>
            </li>
        </ul>
    </div>

    </div>

    <div class="row g-4">

        @foreach (var r in Model.Rooms)
        {
            <div class="col-md-4">
                <div class="card room-card shadow">

                    @if (Model.HotRooms.Contains(r.room_id))
                    {
                        <span class="badge bg-danger position-absolute" style="top:10px; left:10px;">
                            HOT
                        </span>
                    }

                    <img src="@(string.IsNullOrEmpty(r.image) ? "/images/default.jpg" : r.image)"
                         class="card-img-top">

                    <div class="card-body text-center">

                        <h5>
                            @r.title

                            @if (r.room_category == "VIP")
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    VIP
                                </span>
                            }
                        </h5>
                        <p class="text-muted">@r.room_type</p>


                        @if (r.discount_percent > 0)
                        {
                            <div class="position-relative">

                                <!-- BADGE -20% -->
                                <span class="badge bg-danger"
                                      style="position:absolute; top:-10px; right:-10px;">
                                    -@r.discount_percent%
                                </span>

                                <p>
                                    <span class="text-danger text-decoration-line-through">
                                        @r.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ / day
                                    </span><br />

                                    <span class="text-success fw-bold">
                                        @r.final_price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ / day
                                    </span>
                                </p>
                            </div>
                        }
                        else
                        {
                            <p class="text-primary fw-bold">
                                @r.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ / day
                            </p>
                        }

                        <p>
                            Status:
                            @if (r.status?.ToLower() == "available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (r.status?.ToLower() == "pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (r.status?.ToLower() == "booked")
                            {
                                <span class="badge bg-danger">Booked</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@r.status</span>
                            }
                        </p>

                        @{
                            double rating = Model.AvgRating.ContainsKey(r.room_id)
                            ? Model.AvgRating[r.room_id]
                            : 0;

                            var fullStars = (int)Math.Floor(rating);
                            var hasHalfStar = (rating - fullStars) >= 0.5;
                            var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                        }

                        <div class="text-warning">

                            @for (int i = 0; i < fullStars; i++)
                            {
                                <span>★</span>
                            }

                            @if (hasHalfStar)
                            {
                                <span>⯨</span>
                            }

                            @for (int i = 0; i < emptyStars; i++)
                            {
                                <span>☆</span>
                            }

                            <span class="ms-1 text-dark">
                                (@(rating == 0 ? "0" : rating.ToString("0.0")))
                            </span>

                        </div>

                        <p>
                            👤 @r.guests guests | 🛏 @r.bed_type
                        </p>

                        <a asp-page="/HotelDetails" asp-route-id="@r.room_id" class="btn btn-outline-primary">
                            View Details
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>

</section>

<script>
    setTimeout(() => {
        let alerts = document.querySelectorAll(".alert");
        alerts.forEach(a => {
            a.style.transition = "opacity 0.5s";
            a.style.opacity = "0";
            setTimeout(() => a.remove(), 500);
        });
    }, 3000);
</script>


