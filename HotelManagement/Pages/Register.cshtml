@page
@model HotelManagement.Pages.RegisterModel

<style>
    body {
        margin: 0;
        overflow: hidden;
    }

    .bg-slide {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: opacity 1.5s ease-in-out;
    }

    .bg1 {
        z-index: -2;
    }

    .bg2 {
        z-index: -1;
        opacity: 0;
    }

    .register-card {
        width: 420px;
        background: #f5e6d3;
        padding: 40px;
        border-radius: 12px;
    }

    .otp-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .otp-box {
        background: white;
        padding: 30px;
        border-radius: 10px;
        width: 350px;
    }

    .otp-inputs {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .otp {
        width: 45px;
        height: 50px;
        text-align: center;
        font-size: 22px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }
</style>

<div class="bg-slide bg1"></div>
<div class="bg-slide bg2"></div>

<div class="container vh-100 d-flex justify-content-center align-items-center">

    <div class="register-card shadow-lg">

        <h3 class="text-center mb-4">Create Account</h3>

        <!-- SUCCESS MESSAGE -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <!-- ERROR MESSAGE -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <label>Full Name</label>
                <input asp-for="User.name" class="form-control">
                <span asp-validation-for="User.name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input asp-for="User.email" class="form-control">
                <span asp-validation-for="User.email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Password</label>
                <div style="position: relative;">
                    <input asp-for="User.password" type="password" class="form-control" id="passwordInput">

                    <span onclick="togglePassword()"
                          style="position:absolute; right:10px; top:50%; transform:translateY(-50%); cursor:pointer;">
                        👁
                    </span>
                </div>
                <span asp-validation-for="User.password" class="text-danger"></span>
            </div>

            <div id="password-rules" class="mt-2 small">

                <div id="rule-length">❌ Password must be at least 8 characters long</div>
                <div id="rule-lower">❌ Must contain lowercase letter</div>
                <div id="rule-upper">❌ Must contain uppercase letter</div>
                <div id="rule-number">❌ Must contain number</div>
                <div id="rule-special">❌ Must contain special character</div>

            </div>

            <div class="mb-3">
                <label>Phone Number</label>
                <input asp-for="User.phone" class="form-control">
                <span asp-validation-for="User.phone" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">
                Register
            </button>

        </form>

        <div class="text-center mt-3">
            <p>
                Already have an account?
                <a asp-page="/Login">Login</a>
            </p>
        </div>

    </div>

</div>

@if (TempData["ShowOTP"] != null)
{
    <div class="otp-overlay">
        <div class="otp-box">

            <h4 class="text-center mb-3">Verify OTP</h4>

            <form method="post" id="otpForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="action" value="verify" />

                <div class="otp-inputs mb-3">
                    <input maxlength="1" class="otp" />
                    <input maxlength="1" class="otp" />
                    <input maxlength="1" class="otp" />
                    <input maxlength="1" class="otp" />
                    <input maxlength="1" class="otp" />
                    <input maxlength="1" class="otp" />
                </div>

                <input type="hidden" name="InputOTP" id="finalOTP" />

                <div class="text-center mt-2">
                    <button id="resendBtn" type="button" class="btn btn-secondary w-100" disabled>
                        Resend OTP (60s)
                    </button>
                </div>
            </form>

            <button onclick="closeOTP()" class="btn btn-secondary mt-2 w-100">
                Close
            </button>

        </div>
    </div>
}


<script>
    const images = [
        "https://images.unsplash.com/photo-1566073771259-6a8506099945",
        "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4",
        "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb",
        "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa"
    ];

    let index = 0;

    const bg1 = document.querySelector(".bg1");
    const bg2 = document.querySelector(".bg2");

    bg1.style.backgroundImage = "url('" + images[0] + "')";

    function changeBackground() {
        index++;
        if (index >= images.length) index = 0;

        bg2.style.backgroundImage = "url('" + images[index] + "')";
        bg2.style.opacity = 1;

        setTimeout(() => {
            bg1.style.backgroundImage = bg2.style.backgroundImage;
            bg2.style.opacity = 0;
        }, 1500);
    }

    setInterval(changeBackground, 5000);
</script>

<script>
    const inputs = document.querySelectorAll(".otp");

    inputs.forEach((input, index) => {
        input.addEventListener("input", () => {

            if (input.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }

            let otp = "";
            inputs.forEach(i => otp += i.value);

            if (otp.length === 6) {
                document.getElementById("finalOTP").value = otp;
                document.getElementById("otpForm").submit();
            }
        });
    });

    const resendBtn = document.getElementById("resendBtn");

    if (resendBtn) {

        let timeLeft = 60;
        let countdown;

        function startCountdown() {
            clearInterval(countdown);

                resendBtn.classList.remove("btn-success");
                resendBtn.classList.add("btn-secondary");

            countdown = setInterval(() => {
                timeLeft--;
                resendBtn.innerText = "Resend OTP (" + timeLeft + "s)";

                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    resendBtn.disabled = false;
                    resendBtn.innerText = "Resend OTP";

                    resendBtn.classList.remove("btn-secondary");
                    resendBtn.classList.add("btn-success");
                }
            }, 1000);
        }

        startCountdown();

        resendBtn.addEventListener("click", function () {

            resendBtn.disabled = true;
            timeLeft = 60;

            resendBtn.classList.remove("btn-success");
            resendBtn.classList.add("btn-secondary");

            fetch("/Register?handler=ResendOTP", {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": getToken()
                }
            })
            .then(() => console.log("OTP resent"))
            .catch(err => console.error(err));

            startCountdown();
        });

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }
    }


        function closeOTP() {
        window.location.href = "/Register";
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@if (TempData["ShowPopup"] != null)
{
    <div class="otp-overlay">
        <div class="otp-box">

            @if (TempData["ShowPopup"].ToString() == "success")
            {
                <h4 class="text-success">Registration Successful!</h4>
                <button onclick="goLogin()" class="btn btn-success mt-3 w-100">OK</button>
            }
            else
            {
                <h4 class="text-danger">Invalid OTP!</h4>
                <button onclick="closePopup()" class="btn btn-danger mt-3 w-100">OK</button>
            }

        </div>
    </div>
}

<script>
    function goLogin() {
        window.location.href = "/Login";
    }

    function closePopup() {
        window.location.href = "/Register";
    }
</script>

<script>
    const passwordInput = document.querySelector("input[name='User.password']");

    passwordInput.addEventListener("input", function () {
        const value = passwordInput.value;

        checkRule("rule-length", value.length >= 8);
        checkRule("rule-lower", /[a-z]/.test(value));
        checkRule("rule-upper", /[A-Z]/.test(value));
        checkRule("rule-number", /[0-9]/.test(value));
        checkRule("rule-special", /[\W_]/.test(value));
    });

    function checkRule(id, condition) {
        const el = document.getElementById(id);

        if (condition) {
            el.innerHTML = "✅ " + el.innerHTML.substring(2);
            el.style.color = "green";
        } else {
            el.innerHTML = "❌ " + el.innerHTML.substring(2);
            el.style.color = "red";
        }
    }
</script>