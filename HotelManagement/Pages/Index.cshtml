 background-color: var(--gold-dark);
        border-color: var(--gold-dark);
  }

    h2 {
 color: var(--gold-accent);
        font-weight: 700;
    }

    .suggest-box {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 9999;

    max-height: 250px;
    overflow-y: auto;

    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;

    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.suggest-box a {
    padding: 10px;
    cursor: pointer;
}

.suggest-box a:hover {
    background: #f3f3f3;
}

</style>

<script>

       const images = [
    "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa",
    "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4",
    "https://images.unsplash.com/photo-1566073771259-6a8506099945",
    "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb"
    ];

    let index = 0;

    const bg1 = document.querySelector(".hero-bg1");
    const bg2 = document.querySelector(".hero-bg2");

    bg1.style.backgroundImage = "url('" + images[0] + "')";

    function changeHero(){

        index++;

        if(index >= images.length){
            index = 0;
        }

        bg2.style.backgroundImage = "url('" + images[index] + "')";
        bg2.style.opacity = 1;

        setTimeout(()=>{
            bg1.style.backgroundImage = bg2.style.backgroundImage;
            bg2.style.opacity = 0;
        },1500);
    }

    setInterval(changeHero,5000);

    function searchRoom() {

        let destination = document.querySelector("input[placeholder='Destination']").value;
        let checkIn = document.querySelector("[name='checkIn']").value;
        let checkOut = document.querySelector("[name='checkOut']").value;
        let guests = document.querySelector("[name='guests']").value;
        let bedType = document.querySelector("[name='bedType']").value;

        let url = "/Hotels?";

        if (destination) url += "room=" + encodeURIComponent(destination) + "&";
        if (checkIn) url += "checkIn=" + checkIn + "&";
        if (checkOut) url += "checkOut=" + checkOut + "&";
        if (guests) url += "guests=" + guests + "&";
        if (bedType) url += "bedType=" + encodeURIComponent(bedType) + "&";

        window.location.href = url;
    }

</script>

        <script>
    function suggestRoom() {
        let keyword = document.getElementById("searchInput").value;

        if (keyword.length < 1) {
            document.getElementById("suggestList").innerHTML = "";
            return;
        }

        fetch(`/Hotels?handler=Suggest&keyword=${encodeURIComponent(keyword)}`)
            .then(res => res.json())
            .then(data => {
                let html = "";

                data.forEach(r => {
                    html += `
                        <div class="list-group-item list-group-item-action"
                             onclick="selectRoom('${r.title}')">
                            ${r.title}
                        </div>`;
                });

                document.getElementById("suggestList").innerHTML = html;
            });
    }

        function selectRoom(title) {
        document.getElementById("searchInput").value = title;
        document.getElementById("suggestList").innerHTML = "";
    }
        //click vào gợi ý là search luôn
        function selectRoom(title) {
        window.location.href = `/Hotels?room=${encodeURIComponent(title)}`;
    }
</script>