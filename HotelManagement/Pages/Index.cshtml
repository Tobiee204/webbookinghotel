@page
@model IndexModel


<!-- HERO SECTION -->
<section class="hero-section">

    <div class="hero-bg hero-bg1"></div>
    <div class="hero-bg hero-bg2"></div>

    <div class="hero-overlay"></div>

    <div class="hero-content container text-center text-white">

        <h1 class="display-4 fw-bold animate-title">
            Find Your Perfect Hotel
        </h1>

        <p class="lead animate-subtitle">
            Book your hotel room at the best price
        </p>

        <div class="search-box p-4 bg-white rounded shadow-lg animate-search">

            <div class="row g-2 align-items-center">

                <!-- Destination -->
                <div class="col-md-2 position-relative">
                    <input type="text" id="searchInput"
                           class="form-control"
                           placeholder="Destination"
                           onkeyup="suggestRoom()">

                    <div id="suggestList" class="list-group suggest-box"></div>
                </div>

                <!-- Check In -->
                <div class="col-md-2">
                    <input type="date" name="checkIn" class="form-control">
                </div>

                <!-- Check Out -->
                <div class="col-md-2">
                    <input type="date" name="checkOut" class="form-control">
                </div>

                <!-- Guests -->
                <div class="col-md-2">
                    <select name="guests" class="form-select">
                        <option value="">Guests</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </div>

                <!-- Bed Type -->
                <div class="col-md-2">
                    <select name="bedType" class="form-select">
                        <option value="">Bed Type</option>
                        <option>Single</option>
                        <option>Double</option>
                        <option>Queen</option>
                        <option>King</option>
                    </select>
                </div>

                <!-- Search -->
                <div class="col-md-2 d-flex">
                    <button onclick="searchRoom()" class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- POPULAR HOTELS -->
<section class="section-soft py-5">

    <h2 class="text-center mb-4">Popular Hotels</h2>

    <div class="row g-4">

        @foreach (var r in Model.PopularRooms)
        {
            <div class="col-md-4">

                <div class="card shadow">

                    @if (Model.HotRooms.Contains(r.room_id))
                    {
                        <span class="badge bg-danger position-absolute"
                              style="top:10px; left:10px;">
                            HOT
                        </span>
                    }

                    <img src="@(string.IsNullOrEmpty(r.image) ? "/images/default.jpg" : r.image)" class="card-img-top">

                    <div class="card-body text-center">

                        <h5 class="card-title">@r.title</h5>

                        <p class="text-muted">@r.room_type</p>

                        <p class="card-text">
                            @(string.IsNullOrEmpty(r.description) ? "Nice and comfortable room." : r.description)
                        </p>

                        <!--RATING-->

                        @{
                            double rating = Model.AvgRating.ContainsKey(r.room_id)
                            ? Model.AvgRating[r.room_id]
                            : 0;

                            var fullStars = (int)Math.Floor(rating);
                            var hasHalfStar = (rating - fullStars) >= 0.5;
                            var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                        }

                        <div class="text-warning">

                            @for (int i = 0; i < fullStars; i++)
                            {
                                <span>★</span>
                            }

                            @if (hasHalfStar)
                            {
                                <span>⯨</span>
                            }

                            @for (int i = 0; i < emptyStars; i++)
                            {
                                <span>☆</span>
                            }

                            <span class="ms-1 text-dark">
                                (@(rating == 0 ? "0" : rating.ToString("0.0")))
                            </span>

                        </div>

                        <p class="fw-bold text-primary">
                            @r.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ / day
                        </p>

                        <a asp-page="/HotelDetails" asp-route-id="@r.room_id" class="btn btn-outline-primary">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<!-- Our Hotel Services -->
<section class="section-light py-5">

    <h2 class="text-center mb-5">Hotel Services & Amenities</h2>

    <div class="row text-center g-4">

        @foreach (var s in Model.Services)
        {
            <div class="col-md-3">

                <div class="service-card shadow-sm p-4">

                    <img src="@s.image" class="card-img-top">

                    <h4>@s.name</h4>

                    <p>@s.description</p>

                </div>

            </div>
        }

    </div>

</section>

<div class="text-center mt-4">
    <a href="/Service" class="btn btn-primary btn-lg">
        View All Services
    </a>
</div>


<!-- SERVICES -->
<section class="bg-light py-5">

    <div class="container">

        <h2 class="text-center mb-5">Why Choose Us</h2>

        <div class="row text-center g-4">

            <div class="col-md-4">
                <div class="why-card">
                    <h4>Best Price</h4>
                    <p>We guarantee the best hotel prices.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="why-card">
                    <h4>Easy Booking</h4>
                    <p>Book your stay in just a few clicks.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="why-card">
                    <h4>24/7 Support</h4>
                    <p>Our team is always ready to help you.</p>
                </div>
            </div>

        </div>

    </div>

</section>

<style>

    /* Color Variables */
    :root {
        --light-beige: #F5F1ED;
        --gold-accent: #C6A96D;
     --gold-dark: #A68B5B;
  }

    /* Apply Light Beige background to entire page */
    body {
        background-color: var(--light-beige);
    }

    .hero-section {
        position: relative;
  height: 550px;
 background-size: cover;
   background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-overlay {
        position: absolute;
 top: 0;
        left: 0;
  width: 100%;
    height: 100%;
        background: rgba(0,0,0,0.45);
    }

    .hero-content {
    position: relative;
    z-index: 2;
    }

    .search-box {
        max-width: 850px;
        margin: auto;
    }

  .search-box select,
        .search-box input {
          height: 45px;
   }

    /* Animation */

    .animate-title {
    animation: fadeDown 1s ease;
    }

    .animate-subtitle {
     animation: fadeDown 1.5s ease;
    }

    .animate-search {
     animation: fadeUp 1.5s ease;
    }

    /* Keyframes */

    @@keyframes fadeDown {
   from {
       opacity: 0;
        transform: translateY(-30px);
        }

   to {
            opacity: 1;
         transform: translateY(0);
        }
    }

    @@keyframes fadeUp {
   from {
            opacity: 0;
       transform: translateY(40px);
        }

        to {
       opacity: 1;
         transform: translateY(0);
        }
    }

    .hero-section {
        position: relative;
  height: 550px;
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        width: 100%;
        height: 100%;
        background-size: cover;
      background-position: center;
     transition: opacity 1.5s ease-in-out;
    }

    .hero-bg1 {
        z-index: 1;
    }

    .hero-bg2 {
        z-index: 2;
        opacity: 0;
    }

    .hero-overlay {
      position: absolute;
     width: 100%;
   height: 100%;
     background: rgba(0,0,0,0.45);
    z-index: 3;
 }

    .hero-content {
        position: relative;
  z-index: 4;
    }

  .search-box {
        max-width: 850px;
margin: auto;
    }

    .room-card {
  padding: 15px;
   border-radius: 10px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .room-card:hover {
        transform: translateY(-10px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

  .why-card {
        background: linear-gradient(135deg, var(--gold-accent) 0%, var(--gold-dark) 100%);
color: white;
      padding: 30px;
        border-radius: 10px;
        height: 100%;
        transition: all 0.3s ease;
    }

 .why-card:hover {
    transform: translateY(-8px);
  box-shadow: 0 10px 25px rgba(198, 169, 109, 0.3);
        }

    .service-card {
