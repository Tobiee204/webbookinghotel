    }

        .service-card h4 {
         color: var(--gold-accent);
   margin-top: 10px;
            font-weight: 600;
        }

    /* Soft section */

    .section-soft {
        background: var(--light-beige);
    }

    /* Light section */

    .section-light {
    background: linear-gradient(135deg, #FFFBF7 0%, var(--light-beige) 100%);
    }

    .card {
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        border-top: 3px solid var(--gold-accent);
    }

        .card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 35px rgba(198, 169, 109, 0.2);
        }

    .card-img-top {
        height: 220px;
      object-fit: cover;
    }

    /* Gold text color for accents */
    .card-title {
        color: var(--gold-accent);
    font-weight: 600;
    }

    .fw-bold.text-primary {
        color: var(--gold-accent) !important;
    }

    /* Button styling */
    .btn-outline-primary {
        color: var(--gold-accent);
        border-color: var(--gold-accent);
    }

.btn-outline-primary:hover {
