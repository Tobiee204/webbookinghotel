@page
@model HotelManagement.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- KPI -->
    <div class="row">

        <div class="col-lg-3 col-md-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@Model.TotalRooms</h3>
                    <p>Rooms</p>
                </div>
                <div class="icon">
                    <i class="fas fa-bed"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@Model.TotalBookings</h3>
                    <p>All Bookings</p>
                </div>
                <div class="icon">
                    <i class="fas fa-calendar"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@Model.TotalUsers</h3>
                    <p>Users</p>
                </div>
                <div class="icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@Model.TotalRevenue.ToString("N0") VND</h3>
                    <p>Revenue</p>
                </div>
                <div class="icon">
                    <i class="fas fa-money-bill"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- BUTTON GO TO STATISTICS -->
    <div class="mb-4">
        <a href="/Admin/Statistics" class="btn btn-primary">
            <i class="fas fa-chart-line"></i> View Statistics
        </a>
    </div>

    <!-- TABLE -->
    <div class="card">

        <div class="card-header">
            <h3 class="card-title">Recent Bookings</h3>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Payment</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td>@b.booking_id</td>
                            <td>@b.User?.name</td>
                            <td>@b.Room?.title</td>

                            <td>
                                @if (b.status == "pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (b.status == "confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (b.status == "cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                            </td>

                            <td>
                                @if (b.Payment != null)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>