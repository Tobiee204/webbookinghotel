@page
@model HotelManagement.Pages.Admin.EditRoomModel
@{
    Layout = "_AdminLayout";
}

<div class="container py-5">

    <div class="card shadow-lg p-4">

        <h3 class="mb-4 text-center">Edit Room</h3>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center">
                @TempData["ErrorMessage"]
            </div>
        }

        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Room.room_id" />

            <!-- Title -->
            <div class="mb-3">
                <label>Room Title</label>
                <input asp-for="Room.title" class="form-control">
                <span asp-validation-for="Room.title" class="text-danger"></span>
            </div>

            <!-- Location -->
            <div class="mb-3">
                <label>Location</label>
                <input asp-for="Room.room_type" class="form-control">
                <span asp-validation-for="Room.room_type" class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label>Price</label>
                <input asp-for="Room.price" type="number" class="form-control" step="1000" min="0">
                <span asp-validation-for="Room.price" class="text-danger"></span>
            </div>

            <!-- Guests -->
            <div class="mb-3">
                <label>Guests</label>
                <input asp-for="Room.guests" type="number" class="form-control">
                <span asp-validation-for="Room.guests" class="text-danger"></span>
            </div>

            <!-- Bed Type -->
            <div class="mb-3">
                <label>Bed Type</label>
                <input asp-for="Room.bed_type" class="form-control">
                <span asp-validation-for="Room.bed_type" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label>Description</label>
                <textarea asp-for="Room.description" class="form-control"></textarea>
                <span asp-validation-for="Room.description" class="text-danger"></span>
            </div>

            <!-- Facilities -->
            <div class="mb-3">
                <label>Facilities</label>
                <input asp-for="Room.facilities" class="form-control">
                <span asp-validation-for="Room.facilities" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Room Category</label>
                <select asp-for="Room.room_category" class="form-control">
                    <option>Normal</option>
                    <option>VIP</option>
                </select>
            </div>

            <!-- Status -->
            <div class="mb-3">
                <label>Status</label>
                <select asp-for="Room.status" class="form-control">
                    <option value="Available">Available</option>
                    <option value="Booked">Booked</option>
                    <option value="Pending">Pending</option>
                </select>
                <span asp-validation-for="Room.status" class="text-danger"></span>
            </div>


            <div class="mb-3 text-center">
                <label class="d-block mb-2 fw-bold">Current Image</label>

                @if (!string.IsNullOrEmpty(Model.Room.image))
                {
                    <img src="@Model.Room.image"
                         class="img-thumbnail shadow-sm"
                         style="max-width:250px; border-radius:12px;" />
                }
                else
                {
                    <p class="text-muted">No image</p>
                }
            </div>

            <!-- Image -->
            <div class="mb-3">
                <input type="hidden" asp-for="Room.image" />
                <label>Change Main Image</label>
                <input type="file" name="MainImage" class="form-control">
            </div>

            <!--Sub Image-->
            <div class="mb-3">
                <label class="fw-bold">Sub Images</label>

                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.RoomImages)
                    {
                        <div style="position:relative;">
                            <img src="@img.image_url"
                                 class="img-thumbnail"
                                 style="width:150px; height:120px; object-fit:cover;" />

                            <!-- DELETE BUTTON -->
                            <button type="submit"
                                    formaction="?handler=DeleteImage&id=@img.image_id"
                                    formmethod="post"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this image?')"
                                    style="position:absolute; top:5px; right:5px;">
                                🗑
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label>Add More Images</label>
                <input type="file" name="Uploads" multiple class="form-control">
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Update Room
            </button>

        </form>

    </div>

</div>

<script>
    setTimeout(() => {
        let alerts = document.querySelectorAll(".alert");
        alerts.forEach(a => {
            a.style.transition = "opacity 0.5s";
            a.style.opacity = "0";
            setTimeout(() => a.remove(), 500);
        });
    }, 3000);
</script>