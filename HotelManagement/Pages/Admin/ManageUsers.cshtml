@page
@model HotelManagement.Pages.Admin.ManageUsersModel
@{
}

<h3>User Management</h3>

<form method="get" class="mb-3">
    <input type="text" name="search" value="@Model.Search"
           placeholder="Search by name or email..."
           class="form-control" />

    <button class="btn btn-primary mt-2">Search</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Action</th>
            <th>Total Spent</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.name</td>
                <td>@u.email</td>
                <td>@u.phone</td>
                <td>
                    <a href="/Admin/UserDetails?id=@u.user_id" class="btn btn-info btn-sm">View</a>
                </td>
                <td>
                    @(
                      Model.TotalSpent.ContainsKey(u.user_id)
                          ? Model.TotalSpent[u.user_id].ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ"
                          : "0 VNĐ"
                          )
            </td>
            <td>
                <form method="post" asp-page-handler="Toggle" asp-route-id="@u.user_id">
                    <button class="btn btn-sm @(u.is_active ? "btn-success" : "btn-secondary")">
                        @(u.is_active ? "ON" : "OFF")
                    </button>
                </form>
            </td>
            </tr>
        }
    </tbody>
</table>
