@page
@model HotelManagement.Pages.Admin.ManageUsersModel
@{
}

<h3>User Management</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Action</th>
            <th>Total Spent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.name</td>
                <td>@u.email</td>
                <td>@u.phone</td>
                <td>
                    <a href="/Admin/UserDetails?id=@u.user_id" class="btn btn-info btn-sm">View</a>

                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                        <input type="hidden" name="id" value="@u.user_id" />

                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this user?')">
                            Delete
                        </button>
                    </form>
                </td>
                <td>@Model.TotalSpent[u.user_id].ToString("N0") VNĐ</td>
            </tr>
        }
    </tbody>
</table>
