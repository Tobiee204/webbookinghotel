@page
@model HotelManagement.Pages.Admin.UserDetailsModel
@{
}
<h3>User Details</h3>

<p><strong>Name:</strong> @Model.User.name</p>
<p><strong>Email:</strong> @Model.User.email</p>
<p><strong>Phone:</strong> @Model.User.phone</p>

<h4>Bookings</h4>

<table class="table">
    <thead>
        <tr>
            <th>Room</th>
            <th>Check-in</th>
            <th>Check-out</th>
            <th>Status</th>
            <th>Payment</th>
			<th>Total</th>
            <th>Cancel Reason</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.User.Bookings)
        {
            <tr>
                <td>@b.Room.title</td>
                <td>@b.check_in.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                <td>@b.check_out.ToString("dd/MM/yyyy hh:mm:ss tt")</td>

                <td>
                    @if (b.status == "pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (b.status == "confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (b.status == "cancelled")
                    {
                        <span class="badge bg-secondary">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Unpaid</span>
                    }
                </td>

                <td>
                    @if (b.Payment != null)
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Not Paid</span>
                    }
                </td>
                <td>
                    @if (b.status == "cancelled" || b.Payment == null)
                    {
                        <span class="text-muted fw-bold">
                            @((b.final_price ?? 0).ToString("N0")) VNĐ
                        </span>
                    }
                    else
                    {
                        <span class="text-success fw-bold">
                            @((b.final_price ?? 0).ToString("N0")) VNĐ
                        </span>
                    }
                </td>

                <td>
                    @if (b.status == "cancelled")
                    {
                        <span class="text-danger fw-bold">
                            @(string.IsNullOrEmpty(b.cancel_reason) ? "No reason" : b.cancel_reason)
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
