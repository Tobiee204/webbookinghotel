@page
@model HotelManagement.Pages.Admin.ManageBookingsModel

<div class="card">

    <div class="card-header">
        <h3 class="card-title">Manage Bookings</h3>
    </div>

    <div class="card-body">

        <div class="mb-3">
            <a href="?status=all" class="btn btn-secondary btn-sm">All</a>
            <a href="?status=confirmed" class="btn btn-success btn-sm">Confirmed</a>
            <a href="?status=pending" class="btn btn-warning btn-sm">Pending</a>
            <a href="?status=cancelled" class="btn btn-danger btn-sm">Cancelled</a>
        </div>

        <input type="text" id="searchBooking" class="form-control mb-3" placeholder="Search booking...">

        <table class="table table-bordered table-striped" id="bookingTable">

            <thead class="thead-dark">

                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Room</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Status</th>
                    <th width="120">Action</th>
                </tr>

            </thead>

            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@b.booking_id</td>
                        <td>@b.User?.name</td>
                        <td>@b.Room?.title</td>
                        <td>@b.check_in.ToString("dd/MM/yyyy")</td>
                        <td>@b.check_out.ToString("dd/MM/yyyy")</td>

                        <td>
                            @if (b.status == "confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (b.status == "pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@b.status</span>
                            }
                        </td>

                        <td>
                            @if (b.status == "pending")
                            {
                                <form method="post" asp-page-handler="UpdateStatus">
                                    <input type="hidden" name="id" value="@b.booking_id" />

                                    <!-- CONFIRM -->
                                    <button name="status" value="confirmed" class="btn btn-success btn-sm">
                                        Confirm
                                    </button>

                                    <!-- CANCEL -->
                                    <div class="mt-1">
                                        <select name="reason" class="form-select form-select-sm mb-1" onchange="toggleReason(this)">
                                            <option value="The room is under maintenance.">The room is under maintenance.</option>
                                            <option value="The customer requested a cancellation.">The customer requested a cancellation.</option>
                                            <option value="Other">Other reasons</option>
                                        </select>

                                        <input name="customReason"
                                               class="form-control form-control-sm mb-1 custom-reason"
                                               placeholder="Enter another reason..."
                                               style="display:none;" />

                                        <button name="status" value="cancelled"
                                                class="btn btn-danger btn-sm">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            }
                            else if (b.status == "confirmed" && DateTime.Now <= b.check_out)
                            {
                                <!-- CHỈ CÒN CANCEL -->
                                <form method="post" asp-page-handler="UpdateStatus">
                                    <input type="hidden" name="id" value="@b.booking_id" />

                                    <div>
                                        <select name="reason" class="form-select form-select-sm mb-1" onchange="toggleReason(this)">
                                            <option value="The room is under maintenance.">The room is under maintenance.</option>
                                            <option value="The customer requested a cancellation.">The customer requested a cancellation.</option>
                                            <option value="Other">Other reasons</option>
                                        </select>

                                        <input name="customReason"
                                               class="form-control form-control-sm mb-1 custom-reason"
                                               placeholder="Enter another reason..."
                                               style="display:none;" />

                                        <button name="status" value="cancelled"
                                                class="btn btn-danger btn-sm">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">No Action</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>


        <!-- Pagination -->

        <div class="d-flex justify-content-end mt-3">

            <button class="btn btn-outline-secondary btn-sm me-1">Previous</button>

            <button class="btn btn-outline-primary btn-sm me-1">1</button>
            <button class="btn btn-outline-secondary btn-sm me-1">2</button>
            <button class="btn btn-outline-secondary btn-sm me-1">3</button>

            <button class="btn btn-outline-secondary btn-sm">Next</button>

        </div>

    </div>
</div>


<script>

    document.getElementById("searchBooking").addEventListener("keyup", function(){

        var value = this.value.toLowerCase();
        var rows = document.querySelectorAll("#bookingTable tbody tr");

        rows.forEach(function(row){

            row.style.display = row.textContent.toLowerCase().includes(value)
            ? "" : "none";

        });

    });

</script>

<script>
    function toggleReason(select) {
        var input = select.parentElement.querySelector(".custom-reason");

        if (select.value === "Other") {
            input.style.display = "block";
        } else {
            input.style.display = "none";
        }
    }
</script>