@page "{id:int}"
@model HotelManagement.Pages.Admin.EditOfferModel

<h2>Edit Offer</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["ErrorMessage"]
    </div>
}

<form method="post">

    <input type="hidden" asp-for="Offer.offer_id" />

    <!-- CODE -->
    <div class="mb-3">
        <label>Code</label>
        <input asp-for="Offer.code" class="form-control" />
        <span asp-validation-for="Offer.code" class="text-danger"></span>
    </div>

    <!-- DISCOUNT -->
    <div class="mb-3">
        <label>Discount Value</label>
        <input asp-for="Offer.discount_value" type="number" class="form-control" />
        <span asp-validation-for="Offer.discount_value" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Discount Type</label>
        <select asp-for="Offer.discount_type" class="form-select">
            <option value="percent">%</option>
            <option value="amount">VNĐ</option>
        </select>
    </div>

    <!-- TYPE -->
    <div class="mb-3">
        <label>Offer Type</label>
        <select asp-for="Offer.type" class="form-select" id="offerType">
            <option value="condition">Condition</option>
            <option value="event">Event</option>
        </select>
    </div>

    <!-- CONDITION -->
    <div class="mb-3" id="conditionBox">
        <label>Minimum Amount</label>
        <input asp-for="Offer.min_amount" type="number" class="form-control" />
        <span asp-validation-for="Offer.min_amount" class="text-danger"></span>
    </div>

    <!-- EVENT -->
    <div id="eventBox">
        <div class="mb-3">
            <label>Start Date</label>
            <input asp-for="Offer.start_date" type="datetime-local" class="form-control" />
            <span asp-validation-for="Offer.start_date" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>End Date</label>
            <input asp-for="Offer.end_date" type="datetime-local" class="form-control" />
            <span asp-validation-for="Offer.end_date" class="text-danger"></span>
        </div>
    </div>

    <!-- STATUS -->
    <div class="mb-3">
        <label>Status</label>
        <select asp-for="Offer.is_active" class="form-select">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
        <span asp-validation-for="Offer.is_active" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
</form>

@section Scripts {
    <script>
        function toggleFields() {
            var type = document.getElementById("offerType").value;

            document.getElementById("conditionBox").style.display =
                (type === "condition") ? "block" : "none";

            document.getElementById("eventBox").style.display =
                (type === "event") ? "block" : "none";
        }

        document.getElementById("offerType").addEventListener("change", toggleFields);
        toggleFields();
    </script>

    <script>
        setTimeout(() => {
            let alerts = document.querySelectorAll(".alert");
            alerts.forEach(a => {
                a.style.transition = "opacity 0.5s";
                a.style.opacity = "0";
                setTimeout(() => a.remove(), 500);
            });
        }, 3000);
    </script>
}