@page
@model HotelManagement.Pages.Admin.ManageRoomsModel

@if (TempData["Error"] != null)
{
    <div id="alertBox" class="alert alert-danger text-center">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div id="alertBox" class="alert alert-success text-center">
        @TempData["Success"]
    </div>
}

<div class="card">

    <div class="card-header">

        <h3 class="card-title">Manage Rooms</h3>

        <a href="/Admin/AddRoom" class="btn btn-primary float-right">
            <i class="fas fa-plus"></i> Add Room
        </a>

    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["SuccessMessage"]
            </div>
        }

        <input type="text" id="searchRoom" class="form-control mb-3" placeholder="Search room...">

        <table class="table table-bordered table-striped" id="roomTable">

            <thead class="thead-dark">

                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Room Type</th>
                    <th>Status</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th width="150">Action</th>
                    <th>Active</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var r in Model.Rooms)
                {
                    <tr>
                        <td>@r.room_id</td>
                        <td>@r.title</td>
                        <td>@r.room_type</td>

                        <td>
                            @if (r.status == "Available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@r.status</span>
                            }
                        </td>

                        <td>
                            @if (r.room_category == "VIP")
                            {
                                <span class="badge bg-warning text-dark">VIP</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Normal</span>
                            }
                        </td>

                        <td>
                            @if (r.discount_percent > 0)
                            {
                                <span class="text-danger text-decoration-line-through">
                                    @r.price.ToString("N0") VNĐ
                                </span>
                                <br />
                                <span class="text-success fw-bold">
                                    @r.final_price.ToString("N0") VNĐ (-@r.discount_percent%)
                                </span>
                            }
                            else
                            {
                                @($"{r.price:N0} VNĐ")
                                                }
                        </td>

                        <td>

                            <!-- EDIT -->
                            <a asp-page="/Admin/EditRoom" asp-route-id="@r.room_id"
                               class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>

                            <a asp-page="/Admin/ApplyDiscount"
                               asp-route-id="@r.room_id"
                               class="btn btn-info btn-sm">
                                %
                            </a>

                        </td>

                        <td>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@r.room_id">
                                <button class="btn btn-sm @(r.is_active ? "btn-success" : "btn-secondary")">
                                    @(r.is_active ? "ON" : "OFF")
                                </button>
                            </form>
                        </td>

                    </tr>
                }

            </tbody>
            <script>
                setTimeout(() => {
                    let alert = document.querySelector(".alert");
                    if (alert) {
                        alert.style.transition = "opacity 0.5s";
                        alert.style.opacity = "0";
                        setTimeout(() => alert.remove(), 500);
                    }
                }, 3000);
            </script>

        </table>

        <!-- Pagination (giữ nguyên nếu bạn chưa làm backend) -->
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-outline-secondary btn-sm me-1">Previous</button>
            <button class="btn btn-outline-primary btn-sm me-1">1</button>
            <button class="btn btn-outline-secondary btn-sm me-1">2</button>
            <button class="btn btn-outline-secondary btn-sm me-1">3</button>
            <button class="btn btn-outline-secondary btn-sm">Next</button>
        </div>

    </div>
</div>

<script>
    document.getElementById("searchRoom").addEventListener("keyup", function () {

        var value = this.value.toLowerCase();
        var rows = document.querySelectorAll("#roomTable tbody tr");

        rows.forEach(function (row) {
            row.style.display = row.textContent.toLowerCase().includes(value)
                ? "" : "none";
        });

    });
</script>

<script>
    function confirmDelete(status) {
        if (status === "pending" || status === "booked") {
            alert("Room is currently processing or already booked. Cannot delete!");
            return false;
        }

        return confirm("Are you sure you want to delete this room?");
    }
</script>

<script>
    setTimeout(function () {
        var alertBox = document.getElementById("alertBox");
        if (alertBox) {
            alertBox.style.transition = "opacity 0.5s";
            alertBox.style.opacity = "0";

            setTimeout(() => {
                alertBox.remove();
            }, 500);
        }
    }, 3000);
</script>
