@page
@model HotelManagement.Pages.LoginModel

<style>
    body {
        margin: 0;
        overflow: hidden;
    }

    .bg-slide {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: opacity 1.5s ease-in-out;
    }

    .bg1 {
        z-index: -2;
    }

    .bg2 {
        z-index: -1;
        opacity: 0;
    }

    .login-card {
        width: 420px;
        background: #f5e6d3;
        padding: 40px;
        border-radius: 12px;
    }

    .otp-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .otp-box {
        background: white;
        padding: 30px;
        border-radius: 10px;
        width: 350px;
    }

    .otp-inputs {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 15px;
    }

    .otp {
        width: 45px;
        height: 50px;
        text-align: center;
        font-size: 22px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }
</style>

<!-- BACKGROUND -->
<div class="bg-slide bg1"></div>
<div class="bg-slide bg2"></div>

<div class="container vh-100 d-flex justify-content-center align-items-center">

    <div class="login-card shadow-lg">

        <h3 class="text-center mb-4">Login</h3>

        <form method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label>Email</label>
                <input asp-for="Email" class="form-control">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Password</label>

                <div style="position: relative;">
                    <input asp-for="Password" type="password" class="form-control" id="loginPassword">

                    <span onclick="togglePassword()"
                          style="position:absolute; right:10px; top:50%; transform:translateY(-50%); cursor:pointer;">
                        👁
                    </span>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <a href="#" onclick="openForgot(); return false;" style="color:blue;">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Login
            </button>

        </form>

        <div class="text-center mt-3">
            <p>
                Don't have an account?
                <a asp-page="/Register">Register</a>
            </p>
        </div>

    </div>
</div>

<!-- OTP BOX -->
<div id="forgotBox" class="otp-overlay" style="display:none;">
    <div class="otp-box">

        <h4>Reset Password</h4>

        <div id="step1">
            <input type="email" id="resetEmail" placeholder="Enter your email" class="form-control mb-2">
            <button onclick="sendOTP()" class="btn btn-primary w-100">Send OTP</button>
        </div>

        <div id="step2" style="display:none;">
            <div class="otp-inputs">
                <input maxlength="1" class="otp" />
                <input maxlength="1" class="otp" />
                <input maxlength="1" class="otp" />
                <input maxlength="1" class="otp" />
                <input maxlength="1" class="otp" />
                <input maxlength="1" class="otp" />
            </div>

            <input type="hidden" id="finalOTP" />

            <button id="resendBtn" type="button" class="btn btn-secondary w-100" disabled>
                Resend OTP (60s)
            </button>
        </div>

        <div id="step3" style="display:none;">
            <input type="password" id="newPass" placeholder="New Password" class="form-control mb-2">
            <div id="password-rules" class="mt-2 small">
                <div id="rule-length">❌ Password must be at least 8 characters long</div>
                <div id="rule-lower">❌ Must contain lowercase letter</div>
                <div id="rule-upper">❌ Must contain uppercase letter</div>
                <div id="rule-number">❌ Must contain number</div>
                <div id="rule-special">❌ Must contain special character</div>
            </div>
            <input type="password" id="confirmPass" placeholder="Confirm Password" class="form-control mb-2">

            <button onclick="resetPassword()" class="btn btn-danger w-100">Reset Password</button>
        </div>

        <button onclick="closeForgot()" class="btn btn-secondary mt-2 w-100">Close</button>

    </div>
</div>

<!-- BACKGROUND SCRIPT -->
<script>
    const images = [
        "https://images.unsplash.com/photo-1566073771259-6a8506099945",
        "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4",
        "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb",
        "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa"
    ];

    let index = 0;

    const bg1 = document.querySelector(".bg1");
    const bg2 = document.querySelector(".bg2");

    bg1.style.backgroundImage = "url('" + images[0] + "')";

    function changeBackground() {
        index++;
        if (index >= images.length) index = 0;

        bg2.style.backgroundImage = "url('" + images[index] + "')";
        bg2.style.opacity = 1;

        setTimeout(() => {
            bg1.style.backgroundImage = bg2.style.backgroundImage;
            bg2.style.opacity = 0;
        }, 1500);
    }

    setInterval(changeBackground, 5000);
</script>

<script>
    const otpInputs = document.querySelectorAll(".otp");

    otpInputs.forEach((input, index) => {
        input.addEventListener("input", () => {

            if (input.value.length === 1 && index < otpInputs.length - 1) {
                otpInputs[index + 1].focus();
            }

            let otp = "";
            otpInputs.forEach(i => otp += i.value);

            if (otp.length === 6) {
                verifyOTP(otp); // 👈 gọi luôn
            }
        });
    });
</script>


<script>
    const newPassInput = document.getElementById("newPass");

    newPassInput.addEventListener("input", function () {
        const value = newPassInput.value;

        checkRule("rule-length", value.length >= 8);
        checkRule("rule-lower", /[a-z]/.test(value));
        checkRule("rule-upper", /[A-Z]/.test(value));
        checkRule("rule-number", /[0-9]/.test(value));
        checkRule("rule-special", /[\W_]/.test(value));
    });

    function checkRule(id, condition) {
        const el = document.getElementById(id);

        if (condition) {
            el.innerHTML = "✅ " + el.innerHTML.substring(2);
            el.style.color = "green";
        } else {
            el.innerHTML = "❌ " + el.innerHTML.substring(2);
            el.style.color = "red";
        }
    }
</script>


<!-- OTP SCRIPT -->
<script>
    function togglePassword() {
        const input = document.getElementById("loginPassword");
        input.type = input.type === "password" ? "text" : "password";
    }

        function openForgot() {
        document.getElementById("forgotBox").style.display = "flex";

        // RESET UI
        document.getElementById("step1").style.display = "block";
        document.getElementById("step2").style.display = "none";
        document.getElementById("step3").style.display = "none";

        document.getElementById("resetEmail").value = "";
        document.getElementById("otpInput").value = "";
        document.getElementById("newPass").value = "";
        document.getElementById("confirmPass").value = "";

            // reset resendBtn
        if (resendBtn) {
        clearInterval(resendBtn.countdown); // nếu bạn lưu countdown ID
        resendBtn.disabled = true;
        resendBtn.innerText = "Resend OTP (60s)";
    }
   }

    function closeForgot() {
        document.getElementById("forgotBox").style.display = "none";
    }

          function sendOTP() {
        const email = document.getElementById("resetEmail").value;

        fetch("/Login?handler=SendOTP", {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded",
                "RequestVerificationToken": getToken() // 👈 QUAN TRỌNG
            },
            body: "email=" + encodeURIComponent(email)
        })
        .then(res => res.text())
        .then(r => {
            console.log("SERVER RESPONSE:", r);

            if (r.includes("sent")) {
                alert("OTP đã gửi về email!");
                document.getElementById("step1").style.display = "none";
                document.getElementById("step2").style.display = "block";
            } else {
                alert("Email không tồn tại!");
            }
        })
        .catch(err => {
            console.error(err);
            alert("Server error");
        });
    }

            function verifyOTP(otp) {

        fetch("/Login?handler=VerifyOTP", {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded",
                "RequestVerificationToken": getToken()
            },
            body: "otp=" + encodeURIComponent(otp)
        })
        .then(res => res.text())
        .then(r => {
            if (r === "ok") {
                document.getElementById("step2").style.display = "none";
                document.getElementById("step3").style.display = "block";
            } else {
                alert("Invalid OTP");
            }
        });
    }


        function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function resetPassword() {
        const newPass = document.getElementById("newPass").value;
        const confirm = document.getElementById("confirmPass").value;

        if (newPass !== confirm) {
            alert("Passwords do not match");
            return;
        }

        fetch("/Login?handler=ResetPassword", {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded",
                "RequestVerificationToken": getToken()
            },
            body: "newPass=" + encodeURIComponent(newPass)
        })
        .then(() => {
            showSuccessPopup(); // 👈 gọi popup
        })
        .catch(() => alert('Server error'));
    }
</script>
<div id="successPopup" class="otp-overlay" style="display:none;">
    <div class="otp-box text-center">
        <h4 class="text-success">Password changed!</h4>
        <button onclick="goLogin()" class="btn btn-success mt-3">OK</button>
    </div>
</div>

<script>
    function showSuccessPopup() {
        document.getElementById("forgotBox").style.display = "none";
        document.getElementById("successPopup").style.display = "flex";
    }

    function goLogin() {
        window.location.href = "/Login";
    }
</script>

<script>
    const resendBtn = document.getElementById("resendBtn");

    if (resendBtn) {

        let timeLeft = 60;

        startCountdown();

        function startCountdown() {

            resendBtn.disabled = true;
            resendBtn.classList.remove("btn-success");
            resendBtn.classList.add("btn-secondary");

            const countdown = setInterval(() => {
                timeLeft--;
                resendBtn.innerText = "Resend OTP (" + timeLeft + "s)";

                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    resendBtn.disabled = false;

                    resendBtn.innerText = "Resend OTP";
                    resendBtn.classList.remove("btn-secondary");
                    resendBtn.classList.add("btn-success");
                }
            }, 1000);
        }

        resendBtn.addEventListener("click", function () {

            resendBtn.disabled = true;
            timeLeft = 60;

            fetch("/Login?handler=ResendOTP", {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": getToken()
                }
            })
            .then(() => {
                console.log("OTP resent");
            });

            startCountdown();
        });
    }
</script>
