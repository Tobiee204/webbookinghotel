@page "{id:int}"
@model HotelManagement.Pages.BookRoomModel

<section class="container py-5">

    <h2 class="text-center mb-5">Book Your Room</h2>

    <div class="row">

        <!-- ROOM INFO -->
        <div class="col-md-5">

            <div class="card shadow">

                <img src="@(string.IsNullOrEmpty(Model.Room.image) ? "/images/default.jpg" : Model.Room.image)" class="card-img-top">

                <div class="card-body">

                    <h4>@Model.Room.title</h4>

                    <p class="text-muted">@Model.Room.room_type</p>

                    <p>🛏 @Model.Room.bed_type • 👤 @Model.Room.guests guests</p>

                    <p class="text-primary fw-bold fs-5">
                        @Model.Room.price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ / day
                    </p>

                    <p class="text-success fw-bold">
                        Status: @Model.Room.status
                    </p>

                </div>

            </div>

        </div>

        <!-- BOOKING FORM -->
        <div class="col-md-7">

            <div class="card shadow p-4">

                <h4 class="mb-4">Booking Information</h4>

                <form method="post">

                    <div class="row g-3">

                        <!-- Check-in -->
                        <div class="col-md-6">
                            <label class="form-label">Check-in Date</label>
                            <input asp-for="CheckIn" type="date" class="form-control" required>
                        </div>

                        <!-- Check-out -->
                        <div class="col-md-6">
                            <label class="form-label">Check-out Date</label>
                            <input asp-for="CheckOut" type="date" class="form-control" required>
                        </div>

                        <!-- Guests -->
                        <div class="col-md-6">
                            <label class="form-label">Guests</label>
                            <select asp-for="Guests" class="form-select">
                                <option value="1">1 Person</option>
                                <option value="2">2 People</option>
                                <option value="3">3 People</option>
                                <option value="4">4 People</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <h5>
                                Total Price:
                                <span id="totalPrice" class="text-primary">0 VNĐ</span>
                            </h5>
                        </div>


                    </div>

                    <button class="btn btn-primary mt-4 w-100 btn-lg">
                        Confirm Booking
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

<script>
    function calculateTotal() {
        let checkIn = new Date(document.querySelector("[name='CheckIn']").value);
        let checkOut = new Date(document.querySelector("[name='CheckOut']").value);

        if (!checkIn || !checkOut) return;

        let days = (checkOut - checkIn) / (1000 * 60 * 60 * 24);

        let price = @Model.Room.price;

        if (days > 0) {
            document.getElementById("totalPrice").innerText =
                (days * price).toLocaleString('vi-VN') + " VNĐ";
        }
    }

    document.querySelector("[name='CheckIn']").addEventListener("change", calculateTotal);
    document.querySelector("[name='CheckOut']").addEventListener("change", calculateTotal);
</script>
